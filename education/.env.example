# ====================================================================
# NEXUSFLOW EDUCATION ERP — SUPABASE ENVIRONMENT CONFIGURATION
# Copy this file to '.env' and fill in your Supabase project credentials.
# ====================================================================

# --------------------------------------------------------------------
# 1. SUPABASE CREDENTIALS (From Supabase Dashboard -> Project Settings -> API)
# --------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional: Supabase Service Role Key (for admin backend / migration scripts)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Optional: Direct PostgreSQL URI for running setup.sql via psql / CLI
# (From Project Settings -> Database -> Connection string -> URI)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# --------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
# --------------------------------------------------------------------
VITE_APP_NAME="NexusFlow Education ERP"
VITE_DEFAULT_INSTITUTION="Greenwood International School"
VITE_CAMPUS_CODE="GWIS"
VITE_ACADEMIC_YEAR="2024-2025"

# --------------------------------------------------------------------
# 3. AI CHATBOT (Optional)
# --------------------------------------------------------------------
# Google Gemini API key for natural language reasoning in the chatbot
VITE_GEMINI_API_KEY="your-gemini-api-key"
